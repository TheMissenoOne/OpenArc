   assert.notEqual(edited.fingerprint, pending.fingerprint, "the callee's intent is part of the caller's fingerprint");
 }
 console.log("watch-context: .tsx queued, reused analyses see edits, pending siblings by signature ok");
+
+// ── 5. compilation.context.exemplars: an accepted body sharing signature types is shown; a pending or unrelated one is not
+{
+  const code = [
+    'import * as arc from "open-arc";',
+    "type Done = (xs: number[]) => number;",
+    "type Open = (ys: number[]) => number;",
+    "type Text = (t: string) => string;",
+    "type Main = (zs: number[]) => number;",
+    'export const doneSpec = arc.defineRegion<Done>({ id: "x.done", intent: "sum" });',
+    'export const openSpec = arc.defineRegion<Open>({ id: "x.open", intent: "max" });',
+    'export const textSpec = arc.defineRegion<Text>({ id: "x.text", intent: "trim" });',
+    'export const mainSpec = arc.defineRegion<Main>({ id: "x.main", intent: "min" });',
+    "// @openarc:begin x.done",
+    "export const done: Done = (xs) => { return xs.reduce((a, b) => a + b, 0); };",
+    "// @openarc:end x.done",
+    "// @openarc:begin x.open",
+    'export const open: Open = (ys) => arc.todo("x.open");',
+    "// @openarc:end x.open",
+    "// @openarc:begin x.text",
+    "export const text: Text = (t) => { return t.trim(); };",
+    "// @openarc:end x.text",
+    "// @openarc:begin x.main",
+    'export const main: Main = (zs) => arc.todo("x.main");',
+    "// @openarc:end x.main",
+    "",
+  ].join("\n");
+  const fake = fakePorts({ files: { "src/x.ts": code } }).instance;
+  const p = await engine.parse(fake, req, []);
+  await engine.analyze(fake, req, p, [], { offline: true });
+  const r = p.regions.find((x) => x.id === "x.main")!;
+  const b = p.config.backends.local!;
+  for (const id of ["x.done", "x.text"]) p.provenance.set(id, { source: "generated", verifiedBy: ["tsc"] } as never);
+  assert.deepEqual(engine.exemplars(p, r, 0), [], "off by default");
+  const stable = engine.buildContext(p, r, 0, b, { stable: true });
+  p.config.compilation.context.exemplars = 2;
+  const shown = engine.exemplars(p, r, 2);
+  assert.equal(shown.length, 1, `only the accepted, overlapping body: ${shown.join("|")}`);
+  assert.ok(shown[0]!.includes("xs.reduce"));
+  assert.ok(engine.buildContext(p, r, 0, b).includes("xs.reduce"), "it reaches the prompt");
+  assert.equal(engine.buildContext(p, r, 0, b, { stable: true }), stable, "fingerprint input unchanged");
+  p.provenance.delete("x.done");
+  assert.deepEqual(engine.exemplars(p, r, 2), [], "an unverified body is not shown");
+  const done = p.regions.find((x) => x.id === "x.done")!;
+  p.manifest.regions["x.done"] = { hash: done.hash, provenance: { verifiedBy: ["tsc"] } } as never;
+  assert.equal(engine.exemplars(p, r, 2).length, 1, "a body verified in an earlier run counts");
+  p.manifest.regions["x.done"] = { hash: "edited", provenance: { verifiedBy: ["tsc"] } } as never;
+  assert.deepEqual(engine.exemplars(p, r, 2), [], "not after a hand edit");
