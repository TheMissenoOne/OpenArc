+const EXEMPLARS_HEADING = "Verified bodies from this project (other tasks: for style and API use, don't copy them)";
+const sigWords = (r: RegionInfo) => new Set(r.spec.signature.replace(/[\w$]+\??:/g, " ").match(/[A-Za-z_$][\w$]*/g));
+
+/** Up to `k` accepted bodies that passed verification, most shared signature words first, then shared `calls`, then id;
+ *  none without overlap. ponytail: words of the signature text, not the type graph; resolve types if this earns its keep. */
+export function exemplars(p: Project, r: RegionInfo, k: number): string[] {
+  if (k <= 0) return [];
+  const own = sigWords(r), calls = new Set(r.spec.calls ?? []);
+  const verified = (x: RegionInfo) => { // this run's, or the manifest's while the body is still the one it verified (no hand edit since)
+    const m = p.manifest.regions[x.id];
+    const by = (p.provenance.get(x.id) ?? (m?.hash === x.hash ? m.provenance : undefined))?.verifiedBy;
+    return Array.isArray(by) && by.length > 0;
+  };
+  const shared = (x: RegionInfo) => [...sigWords(x)].filter((w) => own.has(w)).length + (x.spec.calls ?? []).filter((c) => calls.has(c)).length;
+  return p.regions
+    .filter((x) => x.kind === "function" && x.id !== r.id && !x.pending && !x.stale && !x.childSpans.length && verified(x) && shared(x) > 0)
+    .sort((a, b) => shared(b) - shared(a) || (a.id < b.id ? -1 : 1))
+    .slice(0, k)
+    .map((x) => `// ${x.spec.symbol}: ${x.spec.signature}\n${x.bodyLines.join("\n")}`);
+}
