 // ── plan.selectTargets ────────────────────────────────────────── spec §8.1 PLAN
 type SelectTargets = (regions: PlanInput[], requested: string[]) => PlanResult;
@@ -53,5 +54,42 @@ export const selectTargetsSpec = arc.defineRegion<SelectTargets>({
 });
 
 // @openarc:begin plan.selectTargets
-export const selectTargets: SelectTargets = (regions, requested) => arc.todo("plan.selectTargets");
+export const selectTargets: SelectTargets = (regions, requested) => {
+  const inScope = new Set<string>();
+  const targets: string[] = [];
+  const skipped: Diagnostic[] = [];
+  const addRegionToScope = (region: PlanInput) => {
+      inScope.add(region.id);
+      if (region.state === 'conflicted') {
+        skipped.push({ code: 'OARC-E061', id: region.id });
+      } else if (region.state === 'developer' && region.stale) {
+        skipped.push({ code: 'OARC-W060', id: region.id });
+      } else if ((region.state === 'pending' || (region.state === 'compiler' && region.stale)) && !skipped.some(diag => diag.id === region.id)) {
+        targets.push(region.id);
+      }
+    };
+  const getDescendants = (region: PlanInput): PlanInput[] => {
+      return regions.filter(r => r.parent === region.id);
+    };
+  const processRegion = (region: PlanInput) => {
+      const descendants = getDescendants(region);
+      descendants.forEach(processRegion);
+      addRegionToScope(region);
+    };
+  if (requested.length === 0) {
+      regions.forEach(region => {
+        if (!inScope.has(region.id)) {
+          processRegion(region);
+        }
+      });
+    } else {
+      requested.forEach(id => {
+        const region = regions.find(r => r.id === id);
+        if (region && !inScope.has(region.id)) {
+          processRegion(region);
+        }
+      });
+    }
+  return { targets, skipped };
+};
 // @openarc:end plan.selectTargets
