+            state.phase = 'ready';
+            state.version = Math.max(...commonVersions);
+            send.push({ type: 'ack', version: state.version });
+          } else {
+            state.phase = 'failed';
+            state.error = 'version-mismatch';
+            send.push({ type: 'reject', reason: 'version-mismatch' });
+          }
+        }
+        break;
+      case 'ack':
+        if (state.phase === 'sent') {
+          if (supported.includes(event.version)) {
+            state.phase = 'ready';
+            state.version = event.version;
+          } else {
+            state.phase = 'failed';
+            state.error = 'version-mismatch';
+            send.push({ type: 'reject', reason: 'version-mismatch' });
+          }
+        }
+        break;
+      case 'reject':
+        if (state.phase !== 'failed') {
