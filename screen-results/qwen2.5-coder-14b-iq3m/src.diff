@@ -102,7 +102,32 @@ export const leastConnectionsSpec = arc.defineRegion<Strategy>({
 
 /** @deprecated Bundled palette is deprecated and frozen since 0.9.0; write your own concepts (see Palette wiki: Building your own palette). */
 // @openarc:begin lb.leastConnections
-export const leastConnections: Strategy = (backends, keys) => arc.todo("lb.leastConnections");
+export const leastConnections: Strategy = (backends, keys) => {
+  const healthyBackends = backends.filter(backend => backend.healthy);
+  if (healthyBackends.length === 0) {
+      return keys.map(() => null);
+    }
+  return keys.map(() => {
+      let minConnections = Infinity;
+      let selectedBackend = null;
+
+      for (const backend of healthyBackends) {
+        if (backend.connections < minConnections) {
+          minConnections = backend.connections;
+          selectedBackend = backend.id;
+        }
+      }
+
+      if (selectedBackend) {
+        const selected = healthyBackends.find(b => b.id === selectedBackend);
+        if (selected) {
+          selected.connections += 1;
+        }
+      }
+
+      return selectedBackend;
+    });
+};
 // @openarc:end lb.leastConnections
 
