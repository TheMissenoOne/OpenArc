 // @openarc:begin sandbox.readHarnessOutput
-export const readHarnessOutput: ReadHarnessOutput = (stdout) => arc.todo("sandbox.readHarnessOutput");
+export const readHarnessOutput: ReadHarnessOutput = (stdout) => {
+  const lines = stdout.split('\n').filter(line => line.trim() !== '');
+  const outcomes: ExampleOutcome[] = [];
+  let complete = false;
+  let expectedDone = 0;
+  for (const line of lines) {
+    const trimmed = line.trim();
+    if (trimmed === '') continue;
+    try {
+      const obj = JSON.parse(trimmed);
+      if (obj.done !== undefined) {
+        complete = true;
+        expectedDone = obj.done;
+      } else {
+        outcomes.push({
+          name: obj.name ?? '<unparseable>',
+          ok: obj.ok ?? false,
+          actual: obj.actual
+        });
+      }
+    } catch {
+      outcomes.push({
+        name: '<unparseable>',
+        ok: false,
+        actual: line
+      });
+    }
+  }
+  const passed = outcomes.filter(o => o.ok).length;
+  const failed = outcomes.filter(o => !o.ok);
+  if (complete && outcomes.length === expectedDone) {
+    return { complete: true, passed, failed };
+  }
+  return { complete: false, passed, failed };
+};
 // @openarc:end sandbox.readHarnessOutput
