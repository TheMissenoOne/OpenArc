{
  "version": 1,
  "backends": {
    "local": {
      "provider": "openai",
      "baseUrl": "http://127.0.0.1:8080/v1",
      "model": "qwen2.5-coder-7b",
      "maxContextTokens": 8192,
      "outputFormat": "json"
    },
    "seed": {
      "provider": "openai",
      "baseUrl": "http://127.0.0.1:8080/v1",
      "model": "seed-coder-8b",
      "maxContextTokens": 8192,
      "outputFormat": "json"
    },
    "qwen35": {
      "provider": "openai",
      "baseUrl": "http://127.0.0.1:8080/v1",
      "model": "qwen3.5-9b",
      "maxContextTokens": 8192,
      "outputFormat": "json"
    },
    "q14": {
      "provider": "openai",
      "baseUrl": "http://127.0.0.1:8080/v1",
      "model": "qwen2.5-coder-14b-iq3m",
      "maxContextTokens": 8192,
      "outputFormat": "json"
    }
  },
  "compilation": {
    "defaultBackend": "local",
    "maxAttempts": 3,
    "context": {
      "initialLevel": 0,
      "expandOnFailure": true
    }
  },
  "regions": {
    "hash.sha256Tagged": {
      "backend": "seed"
    },
    "model.renderTemplate": {
      "backend": "seed"
    },
    "auth.splitToken": {
      "backend": "seed"
    },
    "auth.magicLink": {
      "backend": "seed"
    },
    "lb.leastConnections": {
      "backend": "seed"
    },
    "p2p.decodeLengthPrefixed": {
      "backend": "seed"
    },
    "p2p.encodeVarint": {
      "backend": "seed"
    },
    "p2p.onGossip": {
      "backend": "seed"
    },
    "watch.takeNext": {
      "backend": "seed"
    },
    "auth.password": {
      "backend": "qwen35"
    },
    "lb.weighted": {
      "backend": "qwen35"
    },
    "watch.classifyPath": {
      "backend": "qwen35"
    },
    "p2p.handshake": {
      "backend": "q14"
    },
    "cli.parseArgv": {
      "backend": "qwen35"
    },
    "hash.canonicalJson": {
      "backend": "q14"
    },
    "plan.selectTargets": {
      "backend": "qwen35"
    },
    "sandbox.buildArgv": {
      "backend": "qwen35"
    },
    "sandbox.readHarnessOutput": {
      "backend": "qwen35"
    },
    "block.checkRestrictions": {
      "backend": "qwen35"
    },
    "hash.normalizeOwnedText": {
      "backend": "qwen35"
    },
    "markers.scanMarkers": {
      "backend": "qwen35"
    },
    "markers.buildRegionTree": {
      "backend": "qwen35"
    },
    "model.parseOutput": {
      "backend": "qwen35"
    },
    "txn.recover": {
      "backend": "qwen35"
    },
    "auth.apiKey": {
      "backend": "qwen35"
    },
    "lb.healthCheck": {
      "backend": "qwen35"
    },
    "ui.loginPage": {
      "backend": "qwen35"
    },
    "p2p.decodeVarint": {
      "backend": "qwen35"
    },
    "p2p.broadcast": {
      "backend": "qwen35"
    },
    "compile.run.lock": {
      "backend": "qwen35"
    },
    "compile.run.recover": {
      "backend": "qwen35"
    },
    "compile.run.parse": {
      "backend": "qwen35"
    },
    "compile.run.analyze": {
      "backend": "qwen35"
    },
    "compile.run.plan": {
      "backend": "qwen35"
    },
    "compile.run.generate": {
      "backend": "qwen35"
    },
    "compile.run.stage": {
      "backend": "qwen35"
    },
    "compile.run.commit": {
      "backend": "qwen35"
    },
    "compile.run.unlock": {
      "backend": "qwen35"
    }
  }
}
