{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "core",
    "src",
    "tests",
    "tools"
  ],
  "exclude": [
    "src/palette/loginPage.tsx",
    "tests/fixtures"
  ]
}
